class Solution:
    def removeInvalidParentheses(self, s: str) -> List[str]:
        left = right = 0

        for ch in s:
            if ch == '(':
                left += 1
            elif ch == ')':
                if left:
                    left -= 1
                else:
                    right += 1

        ans = set()

        def backtrack(i, path, balance, l, r):
            if balance < 0:
                return

            if i == len(s):
                if balance == 0 and l == 0 and r == 0:
                    ans.add(''.join(path))
                return

            ch = s[i]

            if ch == '(' and l > 0:
                backtrack(i + 1, path, balance, l - 1, r)

            if ch == ')' and r > 0:
                backtrack(i + 1, path, balance, l, r - 1)

            path.append(ch)

            if ch == '(':
                backtrack(i + 1, path, balance + 1, l, r)
            elif ch == ')':
                backtrack(i + 1, path, balance - 1, l, r)
            else:
                backtrack(i + 1, path, balance, l, r)

            path.pop()

        backtrack(0, [], 0, left, right)

        return list(ans)
