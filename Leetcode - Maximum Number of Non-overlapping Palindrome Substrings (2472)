class Solution:
    def maxPalindromes(self, s: str, k: int) -> int:
        n = len(s)
        dp = [[False] * n for _ in range(n)]

        for i in range(n):
            for j in range(i + 1):
                if s[i] == s[j] and (i - j < 2 or dp[j + 1][i - 1]):
                    dp[j][i] = True

        best = [0] * (n + 1)

        for i in range(1, n + 1):
            best[i] = best[i - 1]

            for j in range(i - k + 1):
                if dp[j][i - 1] and i - j >= k:
                    best[i] = max(best[i], best[j] + 1)

        return best[n]
