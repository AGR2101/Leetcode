class Solution:
    def maximumSaleItems(self, items: List[List[int]], budget: int) -> int:
        MAX = 1500
        n = len(items)

        freq = [0] * (MAX + 1)

        for f, p in items:
            freq[f] += 1

        groups = [[] for _ in range(MAX + 1)]

        for f, p in items:
            free = sum(freq[x] for x in range(f, MAX + 1, f)) - 1
            groups[p].append(1 + free)

        dp = [-1] * (budget + 1)
        dp[0] = 0

        ans = 0

        for p in range(MAX, 0, -1):
            if not groups[p]:
                continue

            groups[p].sort(reverse=True)

            prefix = [0]
            for w in groups[p]:
                prefix.append(prefix[-1] + w)

            for k in range(1, min(len(groups[p]), budget // p) + 1):
                cost = k * p
                reward = prefix[k]

                for b in range(budget - cost + 1):
                    if dp[b] != -1:
                        total = reward + dp[b] + (budget - cost - b) // p
                        ans = max(ans, total)

            for w in groups[p]:
                for b in range(budget, p - 1, -1):
                    if dp[b - p] != -1:
                        dp[b] = max(dp[b], dp[b - p] + w)

        return ans
