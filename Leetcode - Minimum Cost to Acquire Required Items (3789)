class Solution:
    def minimumCost(self, cost1: int, cost2: int, costBoth: int, need1: int, need2: int) -> int:
        a = min(need1, need2)
        b = max(need1, need2)

        return min(
            need1 * cost1 + need2 * cost2,
            a * costBoth + (b - a) * cost1 if need1 > need2 else a * costBoth + (b - a) * cost2,
            b * costBoth
        )
