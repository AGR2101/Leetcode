from math import gcd

class Solution:
    def maxLength(self, nums: list[int]) -> int:
        ans = 0
        n = len(nums)

        for i in range(n):
            prod = 1
            lcm = 1
            g = 0

            for j in range(i, n):
                x = nums[j]

                prod *= x
                g = gcd(g, x)
                lcm = lcm * x // gcd(lcm, x)

                if prod == lcm * g:
                    ans = max(ans, j - i + 1)

        return ans
