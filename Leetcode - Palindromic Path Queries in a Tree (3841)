class Solution:
    def palindromePath(self, n: int, edges: list[list[int]], s: str, queries: list[str]) -> list[bool]:
        g = [[] for _ in range(n)]
        for u, v in edges:
            g[u].append(v)
            g[v].append(u)

        LOG = n.bit_length()
        tin = [0] * n
        tout = [0] * n
        depth = [0] * n
        up = [[0] * n for _ in range(LOG)]
        timer = 0

        stack = [(0, -1, 0)]
        while stack:
            u, p, state = stack.pop()

            if state == 0:
                tin[u] = timer
                timer += 1
                up[0][u] = u if p == -1 else p

                for k in range(1, LOG):
                    up[k][u] = up[k - 1][up[k - 1][u]]

                stack.append((u, p, 1))

                for v in reversed(g[u]):
                    if v != p:
                        depth[v] = depth[u] + 1
                        stack.append((v, u, 0))
            else:
                tout[u] = timer

        def is_ancestor(u, v):
            return tin[u] <= tin[v] < tout[u]

        def lca(u, v):
            if is_ancestor(u, v):
                return u
            if is_ancestor(v, u):
                return v

            for k in range(LOG - 1, -1, -1):
                x = up[k][u]
                if not is_ancestor(x, v):
                    u = x

            return up[0][u]

        bit = [0] * (n + 1)

        def update(i, x):
            i += 1
            while i <= n:
                bit[i] ^= x
                i += i & -i

        def prefix(i):
            res = 0
            i += 1
            while i > 0:
                res ^= bit[i]
                i -= i & -i
            return res

        def range_xor(l, r):
            if l > r:
                return 0
            return prefix(r) ^ prefix(l - 1)

        chars = list(s)
        masks = [1 << (ord(c) - ord('a')) for c in s]

        for u in range(n):
            update(tin[u], masks[u])
            update(tout[u], masks[u])

        ans = []

        for q in queries:
            parts = q.split()

            if parts[0] == "update":
                u = int(parts[1])
                c = parts[2]
                new_mask = 1 << (ord(c) - ord('a'))
                diff = masks[u] ^ new_mask

                update(tin[u], diff)
                update(tout[u], diff)

                masks[u] = new_mask
                chars[u] = c

            else:
                u = int(parts[1])
                v = int(parts[2])
                w = lca(u, v)

                mask = prefix(tin[u]) ^ prefix(tin[v]) ^ masks[w]

                ans.append(mask == 0 or (mask & (mask - 1)) == 0)

        return ans
