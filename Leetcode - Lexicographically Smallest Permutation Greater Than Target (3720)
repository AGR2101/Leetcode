class Solution:
    def lexGreaterPermutation(self, s: str, target: str) -> str:
        n = len(s)
        cnt = [0] * 26

        for c in s:
            cnt[ord(c) - 97] += 1

        ans = []

        for i in range(n):
            x = ord(target[i]) - 97

            if cnt[x]:
                cnt[x] -= 1
                ans.append(target[i])
            else:
                break
        else:
            for i in range(n - 1, -1, -1):
                x = ord(ans[i]) - 97
                cnt[x] += 1
                ans.pop()

                for c in range(x + 1, 26):
                    if cnt[c]:
                        ans.append(chr(c + 97))
                        cnt[c] -= 1
                        for k in range(26):
                            ans.extend(chr(k + 97) * cnt[k])
                        return ''.join(ans)

            return ""

        i = len(ans)

        for c in range(ord(target[i]) - 96, 26):
            if cnt[c]:
                ans.append(chr(c + 97))
                cnt[c] -= 1
                for k in range(26):
                    ans.extend(chr(k + 97) * cnt[k])
                return ''.join(ans)

        for j in range(i - 1, -1, -1):
            x = ord(ans[j]) - 97
            cnt[x] += 1
            ans.pop()

            for c in range(x + 1, 26):
                if cnt[c]:
                    ans.append(chr(c + 97))
                    cnt[c] -= 1
                    for k in range(26):
                        ans.extend(chr(k + 97) * cnt[k])
                    return ''.join(ans)

        return ""
