class Solution:
    def smallestUniqueSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        mod1, mod2 = 10**9 + 7, 10**9 + 9
        base = 101

        h1 = [0] * (n + 1)
        h2 = [0] * (n + 1)
        p1 = [1] * (n + 1)
        p2 = [1] * (n + 1)

        for i in range(n):
            h1[i + 1] = (h1[i] * base + nums[i]) % mod1
            h2[i + 1] = (h2[i] * base + nums[i]) % mod2
            p1[i + 1] = p1[i] * base % mod1
            p2[i + 1] = p2[i] * base % mod2

        def check(length):
            freq = {}

            for i in range(n - length + 1):
                j = i + length

                a = (h1[j] - h1[i] * p1[length]) % mod1
                b = (h2[j] - h2[i] * p2[length]) % mod2

                key = (a, b)
                freq[key] = freq.get(key, 0) + 1

            return 1 in freq.values()

        left, right = 1, n

        while left < right:
            mid = (left + right) // 2

            if check(mid):
                right = mid
            else:
                left = mid + 1

        return left
