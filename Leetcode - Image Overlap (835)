class Solution:
    def largestOverlap(self, img1, img2):
        n = len(img1)
        points1 = []
        points2 = []

        for i in range(n):
            for j in range(n):
                if img1[i][j]:
                    points1.append((i, j))
                if img2[i][j]:
                    points2.append((i, j))

        shifts = {}
        ans = 0

        for x1, y1 in points1:
            for x2, y2 in points2:
                shift = (x2 - x1, y2 - y1)
                shifts[shift] = shifts.get(shift, 0) + 1
                ans = max(ans, shifts[shift])

        return ans
