class Solution:
    def minSumOfLengths(self, arr: List[int], target: int) -> int:
        n = len(arr)
        INF = n + 1

        best = [INF] * (n + 1)
        prefix = 0
        seen = {0: 0}
        ans = INF

        for i in range(1, n + 1):
            prefix += arr[i - 1]

            if prefix - target in seen:
                j = seen[prefix - target]
                length = i - j

                if best[j] != INF:
                    ans = min(ans, best[j] + length)

                best[i] = min(best[i - 1], length)
            else:
                best[i] = best[i - 1]

            seen[prefix] = i

        return -1 if ans == INF else ans
