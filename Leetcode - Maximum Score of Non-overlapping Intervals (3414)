from bisect import bisect_left

class Solution:
    def maximumWeight(self, intervals):
        n = len(intervals)
        a = sorted(
            [(end, start, weight, i) for i, (start, end, weight) in enumerate(intervals)]
        )

        ends = [x[0] for x in a]
        prev = [0] * n

        for i in range(n):
            prev[i] = bisect_left(ends, a[i][1], 0, i)

        dp = [[(0, []) for _ in range(5)] for _ in range(n + 1)]

        def better(x, y):
            if x[0] != y[0]:
                return x if x[0] > y[0] else y
            return x if x[1] < y[1] else y

        for i in range(1, n + 1):
            end, start, weight, idx = a[i - 1]

            for k in range(1, 5):
                skip = dp[i - 1][k]

                score, ids = dp[prev[i - 1]][k - 1]
                take = (score + weight, sorted(ids + [idx]))

                dp[i][k] = better(skip, take)

        return dp[n][4][1]
