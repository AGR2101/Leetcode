class Solution:
    def stoneGameV(self, stoneValue: List[int]) -> int:
        n = len(stoneValue)
        prefix = [0] * (n + 1)

        for i in range(n):
            prefix[i + 1] = prefix[i] + stoneValue[i]

        dp = [[-1] * n for _ in range(n)]

        def dfs(l, r):
            if l == r:
                return 0

            if dp[l][r] != -1:
                return dp[l][r]

            total = prefix[r + 1] - prefix[l]
            best = 0

            left = 0

            for k in range(l, r):
                left += stoneValue[k]
                right = total - left

                if left < right:
                    best = max(best, left + dfs(l, k))

                elif left > right:
                    best = max(best, right + dfs(k + 1, r))

                else:
                    best = max(
                        best,
                        left + max(dfs(l, k), dfs(k + 1, r))
                    )

            dp[l][r] = best
            return best

        return dfs(0, n - 1)
